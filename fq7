#include <iostream>
using namespace std;

// Circle
double area(double r) {
    return 3.14 * r * r;
}

// Rectangle
double area(double l, double b) {
    return l * b;
}

// Triangle
double area(double b, double h, bool) {
    return 0.5 * b * h;
}

int main() {
    int choice;
    cin >> choice;

    if (choice == 1) {
        double r;
        cin >> r;
        cout << area(r);
    }
    else if (choice == 2) {
        double l, b;
        cin >> l >> b;
        cout << area(l, b);
    }
    else if (choice == 3) {
        double b, h;
        cin >> b >> h;
        cout << area(b, h, true);
    }

    return 0;
}